# Without Docker: copy the binary to /usr/local/bin/elibrary-server, create the user
# (sudo useradd --system --home /var/lib/elibrary elibrary), then:
#   sudo cp elibrary-server.service /etc/systemd/system/ && sudo systemctl enable --now elibrary-server
# Put Caddy or nginx in front of 127.0.0.1:8080 for HTTPS.
[Unit]
Description=Child-Safe E-Library sync server
After=network-online.target
Wants=network-online.target

[Service]
User=elibrary
Group=elibrary
StateDirectory=elibrary
Environment=ELIB_ADDR=127.0.0.1:8080
Environment=ELIB_DATA_DIR=/var/lib/elibrary
Environment=ELIB_PUBLIC_URL=https://library.example.org
ExecStart=/usr/local/bin/elibrary-server
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
